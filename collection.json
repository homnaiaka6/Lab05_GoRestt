  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log(\"CSV data:\", pm.iterationData.toObject());\r",
                  "\r",
                  "pm.test(\"CSV data is loaded\", function () {\r",
                  "    pm.expect(pm.iterationData.get(\"name\")).to.not.be.empty;\r",
                  "    pm.expect(pm.iterationData.get(\"gender\")).to.not.be.empty;\r",
                  "    pm.expect(pm.iterationData.get(\"email\")).to.not.be.empty;\r",
                  "    pm.expect(pm.iterationData.get(\"status\")).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    const user = pm.response.json();\r",
                  "    pm.environment.set(\"userId\", user.id);\r",
                  "    pm.environment.set(\"userEmail\", user.email);\r",
                  "}\r",
                  "\r",
                  "pm.test(\"User ID is returned\", function () {\r",
                  "    pm.expect(pm.environment.get(\"userId\")).to.exist;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://gorest.co.in/public/v2/users?Content-Type=application/json",
              "protocol": "https",
              "host": [
                "gorest",
                "co",
                "in"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ],
              "query": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User ID matches created user\", function () {\r",
                  "    const user = pm.response.json();\r",
                  "    pm.expect(user.id).to.eql(\r",
                  "        Number(pm.environment.get(\"userId\"))\r",
                  "    );\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
